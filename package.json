{
  "name": "obsidian-selection-text-color",
  "version": "0.1.1",
  "description": "Obsidian plugin that colors text using fixed readable color names and customizable display colors.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "text-color",
    "plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "jsdom": "29.1.1",
    "obsidian": "latest",
    "tsx": "4.23.13",
    "typescript": "^5.8.3"
  }
}
